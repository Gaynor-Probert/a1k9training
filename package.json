{
  "name": "a1k9-training",
  "version": "1.0.0",
  "main": "generate.js",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "colors": "^1.4.0",
    "kiss-ssg": "^2.1.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build": "node generate",
    "gen": "node generate",
    "dev": "node generate dev",
    "check": "kiss-ssg check generate.js --summary",
    "images:optimise": "node scripts/optimise-images.mjs",
    "qa:serve": "node qa/serve.mjs",
    "qa:pages": "node qa/pages.mjs docs --assert=20",
    "qa:snapshot": "node qa/snapshot.mjs docs after",
    "qa:lh": "node qa/lighthouse.mjs docs after",
    "qa:axe": "node qa/axe.mjs docs after",
    "qa:axe:check": "node qa/check-axe.mjs after",
    "qa:compare": "node qa/compare.mjs after",
    "qa:no-bootstrap": "node qa/no-bootstrap.mjs docs",
    "qa:seo": "node qa/seo-check.mjs docs",
    "qa:dev-watch": "node qa/dev-watch.mjs",
    "qa:baseline": "node qa/snapshot.mjs qa/.baseline-site baseline && node qa/lighthouse.mjs qa/.baseline-site baseline && node qa/axe.mjs qa/.baseline-site baseline",
    "qa": "npm run build && npm run qa:pages && npm run qa:no-bootstrap && npm run qa:seo && npm run qa:snapshot && npm run qa:compare && npm run qa:axe",
    "qa:ci": "npm run build && npm run qa:pages && npm run qa:no-bootstrap && npm run qa:seo && npm run qa:snapshot && npm run qa:compare && npm run qa:axe && npm run qa:axe:check",
    "qa:preview": "node qa/preview.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaynor-Probert/a1k9training.git"
  },
  "author": "Courtenay Probert",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/Gaynor-Probert/a1k9training/issues"
  },
  "homepage": "https://github.com/Gaynor-Probert/a1k9training#readme",
  "description": ""
}
