    <a href="{{link "index" canonical=true}}" class="font-display text-lg font-bold tracking-wide text-white no-underline sm:text-xl">
      Gaynor Probert
    </a>

    <button type="button"
      class="group inline-flex min-h-11 items-center gap-2 rounded-pill px-3 py-2 text-sm font-semibold text-sand-100 hover:bg-brand-700 hover:text-white lg:hidden"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-menu">
      <svg class="size-5 group-aria-expanded:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" />
      </svg>
      <svg class="hidden size-5 group-aria-expanded:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M5 5l10 10M15 5 5 15" />
      </svg>
      <span class="group-aria-expanded:hidden">Menu</span>
      <span class="hidden group-aria-expanded:inline">Close</span>
    </button>

    <div id="site-menu" class="hidden w-full basis-full lg:block lg:w-auto lg:basis-auto" data-nav-panel>
