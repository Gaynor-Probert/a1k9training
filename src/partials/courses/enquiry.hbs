{{!--
  Course enquiry form, rendered at the foot of every course page.

  All seven pages use the SAME form name, so Netlify registers one form and
  every submission carries a hidden `course` field saying which page it came
  from — one inbox and one notification to configure, not seven. The course
  value is baked in at build time from the model's `crumb`, so no query
  string and no JavaScript is involved.

  The fields are the five Gaynor asked for after reading a test submission —
  name, email, mobile, dog's name, dog's age — plus an optional free-text box.
  All five are required: the mobile number because she adds people to the
  class WhatsApp group, which is why the field says so rather than leaving the
  visitor to wonder. Breed is deliberately absent; she did not ask for it, and
  it is a behavioural consultation's question rather than a course enquiry's.

  Inputs keep the site's global :focus-visible ring rather than the
  `focus-visible:outline-none` the older form on /contact/ uses — that
  override drops the two-layer indicator the design system defines, and axe
  does not catch non-text contrast (see CLAUDE.md).

  Labels carry no "*" and no screen-reader-only "required" text: Netlify
  derives each field's display name in the dashboard and the notification
  email from the <label>'s text, so that markup arrived as "Your name
  required". The `required` attribute already conveys the same thing to a
  screen reader, and the two optional fields say so in their own help text.
--}}
<section id="enquire" class="mt-10 scroll-mt-24 rounded-card border border-sand-200 bg-white p-6 sm:p-8">
  <h2 class="mb-2 font-display text-xl text-ink-900">Ask about {{model.crumb}}</h2>

  <p class="mb-6 text-ink-600">
    {{#if model.enquiryLead}}
      {{model.enquiryLead}}
    {{else}}
      Tell Gaynor a little about your dog and she will come back to you with dates, prices and
      whether this is the right course to start on.
    {{/if}}
  </p>

  <form name="course-enquiry" method="POST" action="/thanks/" data-netlify="true"
    netlify-honeypot="bot-field" data-enquiry class="grid gap-5 sm:grid-cols-2">

    {{!-- Netlify pairs a submission to its form by this field. --}}
    <input type="hidden" name="form-name" value="course-enquiry">
    {{!-- Which page the enquiry came from. Baked in at build time. --}}
    <input type="hidden" name="course" value="{{model.crumb}}">
    {{!-- Netlify uses a field literally named `subject` as the notification
          email's subject line. This static value is the no-JavaScript
          fallback; /js/site.js rewrites it on submit to include the sender's
          name, because Gmail threads messages sharing a subject and a
          course-only subject would collapse every enquiry about the same
          course, from different people, into one conversation. --}}
    <input type="hidden" name="subject" value="Course enquiry: {{model.crumb}}">

    <p class="hidden">
      <label>Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field"></label>
    </p>

    <div>
      <label for="enquiry-name" class="block font-medium">
        Your name
      </label>
      <input id="enquiry-name" name="name" type="text" autocomplete="name" required
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
    </div>

    <div>
      <label for="enquiry-email" class="block font-medium">
        Email
      </label>
      <input id="enquiry-email" name="email" type="email" autocomplete="email" spellcheck="false" required
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
    </div>

    <div>
      <label for="enquiry-mobile" class="block font-medium">Mobile number</label>
      <input id="enquiry-mobile" name="mobile" type="tel" autocomplete="tel" required
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
      <p class="mt-1 text-sm text-ink-500">So Gaynor can add you to the class WhatsApp group.</p>
    </div>

    <div>
      <label for="enquiry-dog-name" class="block font-medium">
        Your dog&rsquo;s name
      </label>
      <input id="enquiry-dog-name" name="dog-name" type="text" required
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
    </div>

    <div>
      <label for="enquiry-dog-age" class="block font-medium">
        Your dog&rsquo;s age
      </label>
      <input id="enquiry-dog-age" name="dog-age" type="text" placeholder="e.g. 7 months" required
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
      <p class="mt-1 text-sm text-ink-500">Roughly is fine. It decides which course suits.</p>
    </div>

    <div class="sm:col-span-2">
      <label for="enquiry-message" class="block font-medium">Anything else?</label>
      <textarea id="enquiry-message" name="message" rows="4"
        class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2"></textarea>
    </div>

    <div class="sm:col-span-2">
      <button type="submit" class="btn btn-primary btn-lg">Send enquiry</button>
      <p class="mt-3 mb-0 text-sm text-ink-500">
        Or call Gaynor on
        <a href="tel:+447798500390" class="font-medium text-brand-700 underline underline-offset-4">07798 500390</a>.
      </p>
    </div>
  </form>
</section>
