{{#extend "layout"}}

{{#content "head"}}
<script type="application/ld+json">
{{{stringify (serviceSchema model.heading description (canonical))}}}
</script>
<script type="application/ld+json">
{{{stringify (breadcrumbList (breadcrumb))}}}
</script>
{{/content}}

{{#content "intro"}}
  {{#if model.components.intro}}
    {{> (lookup model.components 'intro')}}
  {{/if}}
{{/content}}

{{#content "main"}}
  <div class="page-header">
      <h1>{{model.heading}}</h1>
  </div>
  <div class="grid gap-8 lg:grid-cols-3">
    <div class="prose-site lg:col-span-2">
      {{#if  model.components.details}}
        {{> (lookup model.components 'details')}}
      {{/if}}
    </div>
    {{#if  model.components.testimonial}}
    <aside class="callout prose-site lg:col-span-1">
      {{> (lookup model.components 'testimonial')}}
    </aside>
    {{/if}}
  </div>

  {{#if  model.faqs}}
    <div class="mt-10">
      {{> "faqs" model.faqs }}
    </div>
  {{/if}}

  {{#if  model.components.foot}}
    <hr class="my-8 border-sand-200" />
    {{> (lookup model.components 'foot')}}
  {{/if}}

{{/content}}

{{#content "scripts"}}{{/content}}

{{/extend}}
