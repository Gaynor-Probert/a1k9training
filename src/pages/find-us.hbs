{{#extend "layout"}}
{{#content "head"}}
<script type="application/ld+json">
{{{stringify (breadcrumbList (breadcrumb))}}}
</script>
{{/content}}
{{#content "intro"}}
<h2 id="get_in_touch">
  How to contact/find A1K9 Training
</h2>

{{/content}}
{{#content "main"}}

<div class="grid gap-10 lg:grid-cols-2">

  <div>

    <div class="page-header">
      <h1 class="mb-3 text-3xl sm:text-4xl">
        Get in Touch
      </h1>
      <p>
        Please complete the form below to find out more about a dog behaviour consultation or a dog training course.
      </p>
    </div>

    <form id="a1k9-contact-consultation" name="a1k9-contact-consultation" method="post" data-netlify="true"
      netlify-honeypot="bot-field" class="space-y-6">

      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field"></label>
      </p>

      <div>
        <label for="first-name" class="block font-medium">
          Name <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <div class="mt-1 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="first-name" class="sr-only">First name</label>
            <input id="first-name" name="first-name" type="text" placeholder="first" required
              class="w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
          </div>
          <div>
            <label for="last-name" class="sr-only">Last name</label>
            <input id="last-name" name="last-name" type="text" placeholder="last" required
              class="w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
          </div>
        </div>
      </div>

      <div>
        <label for="tel" class="block font-medium">
          Mobile number <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <input id="tel" name="mobile" type="tel" maxlength="15" required
          class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
      </div>

      <div>
        <label for="email" class="block font-medium">
          Email <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <input id="email" name="email" type="email" spellcheck="false" maxlength="255" required
          class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
      </div>

      <div>
        <label for="message" class="block font-medium">
          Message <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <textarea id="message" name="message" spellcheck="true" rows="10" required
          class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none"></textarea>
      </div>

      <div>
        <h2 class="text-lg">
          About your dog
        </h2>
        <p class="mt-1 text-sm text-ink-600">Please provide the following details for your dog:</p>
      </div>

      <div>
        <label for="dog-name" class="block font-medium">
          Dog's name <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <input id="dog-name" name="dog-name" type="text" required
          class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
      </div>

      <div>
        <label for="dog-breed" class="block font-medium">
          Dog's breed <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>
        <input id="dog-breed" name="dog-breed" type="text" maxlength="255" required
          class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
      </div>

      <div>
        <label for="dog-age-years" class="block font-medium">
          Dog's age <span class="text-accent-700" aria-hidden="true">*</span><span class="sr-only"> required</span>
        </label>

        <div class="mt-1 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="dog-age-years" class="sr-only">Dog's age, years</label>
            <input id="dog-age-years" name="dog-age-years" type="text" min="0" max="30"
              placeholder="years" required
              class="w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
          </div>
          <div>
            <label for="dog-age-months" class="sr-only">Dog's age, months</label>
            <input id="dog-age-months" name="dog-age-months" type="text" min="0" max="12"
              placeholder="months"
              class="w-full rounded-md border border-sand-300 bg-white px-3 py-2 focus-visible:border-brand-600 focus-visible:outline-none">
          </div>
        </div>
      </div>

      <button id="saveForm" name="saveForm" type="submit" class="btn btn-primary btn-lg">
        Submit
      </button>
    </form>

  </div>

  <div>

    <div class="page-header">
      <h2 class="mb-3 text-2xl sm:text-3xl">
        Find Us
      </h2>
      <p>
        A1K9 Dog Training Academy now runs from two venues near Swansea in
        South Wales — Gaynor will confirm on the day which one your session
        is at, usually depending on the weather: outdoors at the A1K9
        Training Grounds, or indoors at Llys Nini if it's wet.
      </p>
    </div>

    <div>
      <h3 class="text-lg font-semibold">
        A1K9 Training Grounds
      </h3>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d39560.254227981626!2d-3.9974988901576323!3d51.7053036589514!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x486ef696ff0afd73%3A0xd1d8c5e285d0d27a!2sPontarddulais%2C+Swansea+SA4+8NP!5e0!3m2!1sen!2suk!4v1415040298567"
        width="100%" height="450" loading="lazy" title="Map showing A1K9 Training Grounds"
        class="mt-2 h-[450px] w-full rounded-card border-0"></iframe>
      <p class="mt-2 text-sm">
        <a href="https://goo.gl/maps/EsD5W" target="_new" rel="noopener" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">
          View Larger Map
        </a>
      </p>
    </div>

    <div class="mt-8">
      <h3 class="text-lg font-semibold">
        Llys Nini Animal Centre (RSPCA), Penllergaer, SA4 9WB
      </h3>
      <p class="mt-1">
        Our indoor venue for wet-weather sessions, hosted at the RSPCA's Llys
        Nini Animal Centre — with Caffi Nini on site for a coffee and a bite
        to eat before or after your session.
      </p>

      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <img src="/images/find-us/llys-nini-cafe-exterior-v1.webp" alt="Caffi Nini, the on-site cafe at Llys Nini Animal Centre" width="900" height="675" loading="lazy" decoding="async" class="h-auto w-full rounded-card border border-sand-200 object-cover">
        <img src="/images/find-us/llys-nini-cafe-interior-v1.webp" alt="Inside Caffi Nini, serving drinks and snacks at Llys Nini Animal Centre" width="900" height="675" loading="lazy" decoding="async" class="h-auto w-full rounded-card border border-sand-200 object-cover">
        <img src="/images/find-us/llys-nini-car-park-v1.webp" alt="The car park at Llys Nini Animal Centre, Penllergaer" width="900" height="675" loading="lazy" decoding="async" class="col-span-2 h-auto w-full rounded-card border border-sand-200 object-cover sm:col-span-1">
      </div>

      <iframe
        src="https://www.google.com/maps?q=Llys+Nini+Animal+Centre,+Penllergaer,+Swansea+SA4+9WB&output=embed"
        width="100%" height="450" loading="lazy" title="Map showing Llys Nini Animal Centre, Penllergaer"
        class="mt-2 h-[450px] w-full rounded-card border-0"></iframe>
      <p class="mt-2 text-sm">
        <a href="https://www.google.com/maps/search/Llys+Nini+Animal+Centre,+Penllergaer,+Swansea+SA4+9WB" target="_new" rel="noopener" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">
          View Larger Map
        </a>
      </p>
    </div>

  </div>
</div>

{{/content}}

{{/extend}}
