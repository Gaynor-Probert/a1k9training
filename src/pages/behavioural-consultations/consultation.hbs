{{#extend "layout"}}

{{#content "head"}}
<script type="application/ld+json">
{{{stringify (serviceSchema model.heading description (canonical))}}}
</script>
<script type="application/ld+json">
{{{stringify (breadcrumbList "Home" "/" "Consultations" "/behavioural-consultations/" model.heading (canonical))}}}
</script>
{{/content}}

{{#content "intro"}}
  {{#if model.components.intro}}
    {{> (lookup model.components 'intro')}}
  {{/if}}
{{/content}}

{{#content "main"}}
<div class="page-header">
  <h1 class="mb-0 text-3xl sm:text-4xl">{{model.heading}}</h1>
</div>

<div class="grid gap-8 lg:grid-cols-2">
  <div class="prose-site">
    {{#if model.components.details}}
      {{> (lookup model.components 'details')}}
    {{/if}}
  </div>
  <div class="space-y-6">
    {{> "behavioural-consultations/shared/vet-referrals" }}
    {{> "behavioural-consultations/shared/what-to-expect-in-a-behavioural-consultation" }}
  </div>
</div>

<div class="mt-8">
  <a href="https://cprobert.wufoo.com/forms/gaynor-probert/" class="btn btn-accent" target="_blank" rel="noopener">Contact Me</a>
</div>

{{/content}}

{{#content "scripts"}}{{/content}}

{{/extend}}
