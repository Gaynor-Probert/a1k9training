{{#extend "layout"}}

{{#content "head"}}
{{#if (eq model.slug "index")}}
<script type="application/ld+json">
{{{stringify (breadcrumbList "Home" "/" "About Us" (canonical))}}}
</script>
{{else}}
<script type="application/ld+json">
{{{stringify (breadcrumbList "Home" "/" "About Us" "/about/" model.heading (canonical))}}}
</script>
{{/if}}
{{#if model.person}}
<script type="application/ld+json">
{{{stringify (personSchema model.person.name model.person.jobTitle description (heroImage model) (canonical) model.person.credentials)}}}
</script>
{{/if}}
{{/content}}

{{#content "intro"}}
  {{#if model.components.intro}}
    {{> (lookup model.components 'intro')}}
  {{/if}}
{{/content}}

{{#content "main"}}
<div class="page-header">
  <h1 class="mb-0 text-3xl sm:text-4xl">{{model.title}}</h1>
</div>

{{#if model.components.row1}}
<div class="prose-site">
  {{> (lookup model.components 'row1')}}
</div>
{{/if}}

{{#if model.components.row2}}
<div class="mt-8">
  {{> (lookup model.components 'row2')}}
</div>
{{/if}}

{{#if model.components.section3}}
<div class="mt-8">
  {{> (lookup model.components 'section3')}}
</div>
{{/if}}

{{#if model.next.name}}
  <div class="mt-8">
    <a href="{{ model.next.link }}" class="btn btn-primary">Next: {{ model.next.name}}</a>
  </div>
{{/if}}

{{/content}}
{{/extend}}
